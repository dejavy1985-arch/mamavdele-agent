# Рабочее состояние и журналы центра (создаются во время работы).
var/

# Реальный конфиг с вашим user_id (шаблон лежит рядом: control_center.example.json).
config/control_center.json

# Токен Telegram-бота: секрет, в git не попадает.
config/telegram_token.txt
telegram_token.txt

# Поручения, память и любые рабочие данные домиков.
homes/*/inbox/
homes/*/memory/*
!homes/*/memory/.gitkeep

# Python
__pycache__/
*.pyc

# Рабочие данные агентов внутри домиков (результаты, журналы, их HOME-настройки).
homes/*/results/
homes/*/tmp/
homes/*/runs.log
homes/*/notes.txt
homes/*/.claude/
homes/*/.claude.json
homes/*/.cache/

# Всё, что создаёт пробный агент в своей папке, кроме описания домика.
homes/trial-claude/*
!homes/trial-claude/manifest.json
!homes/trial-claude/CLAUDE.md
!homes/trial-claude/secrets/
